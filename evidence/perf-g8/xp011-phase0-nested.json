 "nested_summary": {
  "structure": "Observer::progress = tx1 task_facts(read_bound_task + publications slim + range_result x100) -> tx2 verify_versions -> tx3 verify_range_results(range_result x100) -> verify_yearly/stopped/pubcheck -> enc",
  "cv_fixed_per_call": 400,
  "cv_fixed_decomposition": "200 read_market_update x 2 require_published_facts (base+result); read_market_update 200 = 100 items x 2 transactions (task_facts tx + verify_range_results tx)",
  "read_segment_per_call": 11168,
  "read_segment_per_fixed": "~27.9 (segment row reads+decode+hash inside fixed())",
  "materialize_header": {
   "append": 1000,
   "nochange": 800
  },
  "wire_decode_us": 7,
  "response_serialize_ms": "~0.7-1.2",
  "dominant": "cv_fixed incl ~= 10.2-14.6s of 11.0-15.6s span (~93-95%); read_segment excl ~= 8.1-11.4s inside it"
 },
 "dedup_model": {
  "nochange": "base==result per item; tx-scoped memo on version_key halves cv_fixed per tx: 400->200 total (model, not measured)",
  "append": "all 200 versions distinct per tx; intra-tx dedup saves 0 (model)",
  "cross_tx": "task_facts tx and verify_range_results tx are separate market.read calls; verified-facts ctx cannot span them per spec (no cross-request trust) - verify_* revalidation stays full",
  "materialize_header_dedup": "same version header-read via publications + audit paths; bounded ctx could also memoize (~0.3-0.5s potential, minor)"
 },
 "not_measured": [
  "queue/writer wait inside market.read (no probe on WriteCoordinator::read; bounded indirectly: progress excl ~3-17ms, single-threaded handler => read-tx wait is small but NOT_MEASURED precisely)",
  "per-function sqlite3_step attribution (steps counted only at call granularity)",
  "availability/task_list path (out of Phase-0 scope)",
  "verify_versions tx2 isolated timing (inlined into progress; materialize_header counts include it)"
 ],
