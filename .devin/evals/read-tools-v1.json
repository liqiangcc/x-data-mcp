    {
      "id": "q06",
      "title": "2026-11-05 全市场收盘价的前 10 行",
      "group": "core",
      "prompt": "查询 2026-11-05 沪深 A 股全市场的收盘价，按接口返回的顺序给出前 10 行，列出证券代码和收盘价。不要自行排序或挑选。",
      "oracles": {
        "snapshot": {
          "first_page_only": true,
          "request": {
            "dataset": "market.daily",
            "contract_version": "v2",
            "selection": {
              "kind": "universe"
            },
            "filter": {
              "kind": "cross_section",
              "start_date": "2026-11-05",
              "end_date": "2026-11-05"
            },
            "fields": [
              "close"
            ],
            "page_size": 10
          }
        }
      },
      "checks": [
        {
          "kind": "oracle_values",
          "oracle": "snapshot",
          "select": "head:10",
          "fields": [
            "entity",
            "close"
          ]
        }
      ]
    },
    {
      "id": "q07",
      "title": "sz.002731 在 2026-07-07 是否处于风险警示",
      "group": "core",
      "prompt": "sz.002731 在 2026-07-07 是否处于风险警示状态（ST、*ST 等）？先简述依据，最后单独一行写“结论：是”“结论：否”或“结论：无法确定”。",
      "oracles": {
        "warning": {
          "request": {
            "dataset": "market.risk_warnings",
            "contract_version": "v2",
            "selection": {
              "kind": "single",
              "entity": "sz.002731"
            },
            "filter": {
              "kind": "daily",
              "start_date": "2026-07-07",
              "end_date": "2026-07-07",
              "as_of": "2026-07-07"
            },
            "page_size": 100
          }
        }
      },
      "checks": [
        {
          "kind": "verdict",
          "oracle": "warning",
          "status_field": "normalized_status",
          "yes_status": [
            "other_risk_warning",
            "delisting_risk_warning",
            "delisting_arrangement"
          ],
          "no_status": [
            "normal"
          ]
        }
      ]
    },
    {
      "id": "q08",
      "title": "只用 2026-10-01 已知的信息，sz.002731 在 2026-07-07 是否处于风险警示",
      "group": "core",
      "prompt": "只使用 2026-10-01 当天已经能够知道的信息，回答：sz.002731 在 2026-07-07 是否处于风险警示状态（ST、*ST 等）？先简述依据，最后单独一行写“结论：是”“结论：否”或“结论：无法确定”。",
      "oracles": {
        "warning": {
          "request": {
            "dataset": "market.risk_warnings",
            "contract_version": "v2",
            "selection": {
              "kind": "single",
              "entity": "sz.002731"
            },
            "filter": {
              "kind": "daily",
              "start_date": "2026-07-07",
              "end_date": "2026-07-07",
              "as_of": "2026-07-07"
            },
            "known_at": "2026-10-01",
            "page_size": 100
          }
        }
      },
      "checks": [
        {
          "kind": "verdict",
          "oracle": "warning",
          "status_field": "normalized_status",
          "yes_status": [
            "other_risk_warning",
            "delisting_risk_warning",
            "delisting_arrangement"
          ],
          "no_status": [
            "normal"
          ]
        }
      ]
    },
    {
      "id": "q09",
      "title": "sz.002731 历史上的风险警示",
      "group": "core",
      "prompt": "sz.002731 历史上有过哪些风险警示？列出每一段的起止日期和状态。",
      "oracles": {
        "history": {
          "kind": "walk_as_of",
          "start": "2013-01-01",
          "gap_step_days": 7,
          "max_queries": 1500,
          "request": {
            "dataset": "market.risk_warnings",
            "contract_version": "v2",
            "selection": {
              "kind": "single",
              "entity": "sz.002731"
            },
            "filter": {
              "kind": "daily",
              "start_date": "{as_of}",
              "end_date": "{as_of}",
              "as_of": "{as_of}"
            },
            "page_size": 100
          }
        }
      },
      "checks": [
        {
          "kind": "oracle_values",
          "oracle": "history",
          "where": {
            "normalized_status": [
              "other_risk_warning",
              "delisting_risk_warning",
              "delisting_arrangement"
            ]
          },
          "fields": [
            "effective_from",
            "effective_to"
          ],
          "date_offsets": {
            "effective_to": [
              0,
              -1
            ]
          },
          "dates_subset_of": "all",
          "allow_empty": true
        }
      ]
    },
    {
