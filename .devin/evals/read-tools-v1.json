      "oracles": {
        "bars": {
          "request": {
            "dataset": "market.daily",
            "contract_version": "v2",
            "selection": {
              "kind": "single",
              "entity": "sh.510300"
            },
            "filter": {
              "kind": "daily",
              "start_date": "2026-11-01",
              "end_date": "2026-11-30"
            },
            "adjustment": "raw",
            "page_size": 100
          }
        }
      },
      "checks": [
        {
          "kind": "oracle_values",
          "oracle": "bars",
          "fields": [
            "date",
            "open",
            "high",
            "low",
            "close",
            "volume"
          ],
          "dates_subset_of": "selected"
        }
      ]
    },
