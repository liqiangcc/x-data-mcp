    {
      "id": "q11",
      "title": "2023-2025 年连续三年收阴且有 2022 年年线的沪深 A 股",
      "group": "screen",
      "prompt": "找出 2023、2024、2025 三年的年线都收阴（收盘价低于开盘价），并且 2022 年也有年线的沪深 A 股。给出符合条件的股票总数，并按证券代码（6 位数字）从小到大列出前 10 只的代码。",
      "oracles": {
        "screen": {
          "kind": "screen",
          "batch_size": 100,
          "members": {
            "dataset": "securities.catalog",
            "contract_version": "v2",
            "selection": {
              "kind": "catalog",
              "scope": "current_sh_sz_a"
            },
            "filter": {
              "kind": "catalog"
            },
            "fields": [
              "name"
            ],
            "page_size": 1000
          },
          "request": {
            "dataset": "market.yearly",
            "contract_version": "v2",
            "filter": {
              "kind": "yearly",
              "start_year": 2022,
              "end_year": 2025
            },
            "page_size": 1000
          },
          "rule": {
            "type": "yearly_down",
            "present_years": [
              2022,
              2023,
              2024,
              2025
            ],
            "down_years": [
              2023,
              2024,
              2025
            ]
          }
        }
      },
      "checks": [
        {
          "kind": "screen",
          "oracle": "screen",
          "top": 10
        }
      ]
    },
    {
      "id": "q12",
      "title": "2026-11-05 收盘价低于 2 元的沪深 A 股",
