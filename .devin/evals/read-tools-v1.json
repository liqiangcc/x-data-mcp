{
  "id": "read-tools-v1",
  "design": "docs/tasks/issue-525-read-tools.md section 9",
  "issue": 525,
  "server_name": "x-data-mcp",
  "system_prompt": "你是 x-data-mcp 行情数据的只读查询助手。今天是 {today}（Asia/Shanghai）。只使用提供的数据工具回答，不要凭记忆给出数据值；工具查不到时如实说明，不要编造。用中文回答，只给问题要求的内容。数值保持工具返回的精度，不要四舍五入，不要换算单位。",
  "scopes": {
    "baseline": [
      "get_data_capabilities",
      "query_data",
      "get_data_availability",
      "list_data_versions",
      "list_catalog_facets"
    ],
    "new": [
      "get_data_capabilities",
      "query_data",
      "get_data_availability",
      "list_data_versions",
      "list_catalog_facets",
      "find_securities",
      "get_daily_bars",
      "get_yearly_bars",
      "get_index_bars",
      "get_market_snapshot",
      "get_security_state",
      "get_security_history",
      "get_security_events",
      "get_trading_calendar",
      "get_price_limit_rules",
      "get_tradability",
      "get_market_cap"
    ],
    "new-no-query": [
      "get_data_capabilities",
      "get_data_availability",
      "list_data_versions",
      "list_catalog_facets",
      "find_securities",
      "get_daily_bars",
      "get_yearly_bars",
      "get_index_bars",
      "get_market_snapshot",
      "get_security_state",
      "get_security_history",
      "get_security_events",
      "get_trading_calendar",
      "get_price_limit_rules",
      "get_tradability",
      "get_market_cap"
    ]
  },
  "acceptance": {
    "max_avg_turns": 2,
    "min_token_reduction": 0.3
  },
  "tasks": [
    {
      "id": "q01",
      "title": "贵州茅台的代码和行业",
      "group": "core",
      "prompt": "贵州茅台的股票代码和所属行业是什么？请给出代码（格式如 sh.600000）、行业代码和行业名称。",
      "oracles": {
        "catalog": {
          "request": {
            "dataset": "securities.catalog",
            "contract_version": "v2",
            "selection": {
              "kind": "catalog",
              "scope": "current_sh_sz_a"
            },
            "filter": {
              "kind": "catalog",
              "name_query": "贵州茅台"
            },
            "fields": [
              "name",
              "industry_code",
              "industry_name"
            ],
            "page_size": 50
          }
        }
      },
      "checks": [
        {
          "kind": "oracle_values",
          "oracle": "catalog",
          "where": {
            "name": [
              "贵州茅台"
            ]
          },
          "fields": [
            "entity",
            "industry_code",
            "industry_name"
          ]
        }
      ]
    },
    {
      "id": "q02",
      "title": "sh.600000 最近 5 个交易日的日线",
      "group": "core",
      "prompt": "查询 sh.600000 最近 5 个交易日的日线，列出每个交易日的日期、开盘价、最高价、最低价、收盘价、成交量。",
      "oracles": {
        "bars": {
          "request": {
            "dataset": "market.daily",
            "contract_version": "v2",
            "selection": {
              "kind": "single",
              "entity": "sh.600000"
            },
            "filter": {
              "kind": "daily",
              "start_date": "{today-45}",
              "end_date": "{today}"
            },
            "page_size": 100
          }
        }
      },
      "checks": [
        {
          "kind": "oracle_values",
          "oracle": "bars",
          "select": "tail:5",
          "fields": [
            "date",
            "open",
            "high",
            "low",
            "close",
            "volume"
          ],
          "dates_subset_of": "selected"
        }
      ]
    },
    {
      "id": "q03",
      "title": "sh.510300（ETF）11 月的日线",
      "group": "core",
